{
  "name": "warriors-ff",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "setup:espn": "python3 -m venv .venv-espn && .venv-espn/bin/pip install -r apps/studio/scripts/requirements.txt",
    "fetch-league": ".venv-espn/bin/python apps/studio/scripts/fetch-espn-league.py",
    "fetch-league:all": ".venv-espn/bin/python apps/studio/scripts/fetch-espn-league.py --all-years",
    "import-league": "cd apps/studio && npx sanity exec scripts/import-league-data.ts --with-user-token",
    "sync-league": "pnpm fetch-league && pnpm import-league"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20"
  }
}